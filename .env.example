DATABASE_URI=postgresql://doorlockshop:doorlockshop@localhost:5432/doorlockshop
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob storage for the Media collection.
# Leave EMPTY locally: without it, uploads fall back to the local `media/` folder.
# On Vercel it is injected automatically once a Blob Store is linked to the project.
# Only set it by hand when running `npm run seed` against the production database.
BLOB_READ_WRITE_TOKEN=
